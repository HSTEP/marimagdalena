# Copy to `.env` beside docker-compose.yaml and fill in. `.env` is gitignored.
#
# Compose reads this file twice: once to substitute ${...} in the compose file,
# and once to hand the whole thing to the container. So `$` starts a variable
# name here, and a value containing one comes out mangled with nothing said.
# Nothing below should contain a `$`; if you add something that does, write it
# as `$$`.


# --- who may log in -------------------------------------------------------- #

# Generate with:  python api.py hash-password  — and copy the whole line.
MARI_PASSWORD_HASH=scrypt:16384:8:1:...:...

# Signs the session cookie. Any long random string; `openssl rand -hex 32` will
# do. Changing it signs everyone out, which on a phone means finding the
# password again — so set it once and leave it.
SESSION_SECRET=


# --- where publishing goes ------------------------------------------------- #

# No default on purpose. Point it at a scratch branch until a whole publish has
# been watched from end to end, and only then at main.
PUBLISH_BRANCH=scratch
PUBLISH_REMOTE=origin

# Whose name is on the commits. She is the author; the point of the history is
# to be able to say "this is the change from Tuesday" and put it back.
GIT_AUTHOR_NAME=Maří Magdalena
GIT_AUTHOR_EMAIL=web@marimagdalena.cz


# --- the host ------------------------------------------------------------- #

# The checkout is bind-mounted and written to. These must be the uid and gid
# that own it, or the container writes files the host cannot pull over.
#   stat -c '%u %g' .
# Baked into the image, so changing them needs:  docker compose up -d --build
MARI_UID=1000
MARI_GID=1000

# An SSH deploy key with write access to HSTEP/marimagdalena, mode 400 or 600.
# Add the public half under Settings → Deploy keys, with "Allow write access".
MARI_DEPLOY_KEY=/etc/mari/deploy_key
